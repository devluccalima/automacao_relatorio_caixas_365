# Copie para .env e preencha. Comentários só em linhas próprias, sem aspas e sem espaços em volta do =.

# --- Graph (registro de aplicativo próprio, só leitura) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Exchange Online (certificado; usado pelo push das alterações) ---
# Pode ser o mesmo app/certificado da automação de inativos (precisa de Exchange.ManageAsApp)
EXO_APP_ID=
EXO_THUMBPRINT=
EXO_ORGANIZATION=
# Opcional: pwsh se o módulo estiver no PowerShell 7 (no servidor, deixe sem)
POWERSHELL_EXE=

# --- Quem entra no relatório ---
# true inclui contas sem nenhuma licença paga (só gratuitas ou nenhuma)
INCLUIR_SEM_LICENCA_PAGA=false
# true inclui contas com o login bloqueado
INCLUIR_BLOQUEADAS=false

# --- Execução ---
# true só simula as alterações do Alteracoes.xlsx; false grava no Exchange
DRY_RUN=true
# Máximo de contas alteradas por execução; o resto fica "Aguardando" para a próxima
LIMITE_ALTERACOES=50
# true coloca no Alteracoes.xlsx as correções certas (caixa, acento, "(a)", abreviação, apelidos.csv)
AUTOCORRIGIR=true
# Dias de retenção dos retratos diários
RETENCAO_RETRATOS_DIAS=90

# --- Fase 2: SharePoint e e-mail ---
SHAREPOINT_SITE_ID=
SHAREPOINT_PASTA=
EMAIL_REMETENTE=
EMAIL_DESTINATARIO=
