# Copie para .env e preencha. Comentários só em linhas próprias, sem aspas e sem espaços em volta do =.

# --- Graph (registro de aplicativo próprio, só leitura) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Exchange Online (certificado) ---
EXO_APP_ID=
EXO_THUMBPRINT=
EXO_ORGANIZATION=
# Opcional: pwsh se o módulo estiver no PowerShell 7 (no servidor, deixe sem)
POWERSHELL_EXE=

# --- Execução ---
# true só simula as alterações (fase 3 em diante)
DRY_RUN=true
# Acima disso, o push aborta sem alterar nada
LIMITE_ALTERACOES=50
# Dias de retenção dos retratos diários
RETENCAO_RETRATOS_DIAS=90

# --- Fase 2: SharePoint e e-mail ---
SHAREPOINT_SITE_ID=
SHAREPOINT_PASTA=
EMAIL_REMETENTE=
EMAIL_DESTINATARIO=
