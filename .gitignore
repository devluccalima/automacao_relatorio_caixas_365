# Segredos
.env

# Ambiente Python
.venv/
__pycache__/
*.pyc

# Saídas (contêm dados de usuários)
relatorios/*
retratos/*
logs/*
!relatorios/.gitkeep
!retratos/.gitkeep
!logs/.gitkeep
config/*.csv
carga_inicial/padronizacao_*.xlsx

# Alterações (contêm e-mails)
alteracoes/
carga_inicial/Alteracoes_*.xlsx

# Certificados e exportações
*.pfx
*.cer

# Arquivos temporários do Excel
~$*
